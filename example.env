# Google Cloud Project Settings
# Required for Google Vertex AI (Gemini models) and Anthropic Claude via Vertex AI
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_LOCATION=asia-northeast1

# Google Cloud Authentication
# Set up Google Cloud Application Default Credentials (ADC)
# Run: gcloud auth application-default login
# Or set GOOGLE_APPLICATION_CREDENTIALS to point to your service account key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
